{
  "name": "vktry-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:motion": "python3 scripts/prepare-motion-assets.py",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --config wrangler.pages.jsonc --project-name vktry-focus --branch main",
    "preview:pages": "wrangler pages dev dist --config wrangler.pages.jsonc --ip 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.158.0"
  }
}
